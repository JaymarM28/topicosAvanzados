# ---------------------------------------------------------------------------
# Plantilla de configuración de Flyway — Sesión 2
#
# Uso:
#   1. cp flyway.conf.example flyway.conf
#   2. Reemplaza HOST, USUARIO y PASSWORD con los datos de TU branch dev de Neon.
#   3. Ejecuta desde esta carpeta:  flyway info
#
# flyway.conf está excluido en el .gitignore raíz — nunca se versiona.
# Solo flyway.conf.example se sube al repositorio.
#
# ⚠️ Esta configuración apunta a DEV. La branch main la migra GitHub Actions,
#    nunca tu terminal.
# ---------------------------------------------------------------------------

# Flyway usa JDBC, no el formato URI de Neon. Toma el connection string del
# Console y tradúcelo:
#
#   Neon : postgresql://usuario:clave@HOST/neondb?sslmode=require
#   JDBC : jdbc:postgresql://HOST/neondb?sslmode=require
#
# El usuario y la contraseña salen de la URI y van en sus propias claves.
# No incluyas `channel_binding=require`: el driver JDBC no lo reconoce.
flyway.url=jdbc:postgresql://HOST.us-east-2.aws.neon.tech/neondb?sslmode=require
flyway.user=USUARIO
flyway.password=PASSWORD

# Dónde están los scripts, relativo a esta carpeta.
flyway.locations=filesystem:sql_migrations

# Bloquea `flyway clean`, que borra el schema completo. No hay ningún momento del
# curso en que quieras ejecutarlo, y sí varios en que podrías hacerlo por error.
flyway.cleanDisabled=true

# Rechaza migraciones cuyo nombre no siga la convención V<version>__<desc>.sql.
# Un archivo mal nombrado no se ejecutaría y nadie lo notaría hasta producción.
flyway.validateMigrationNaming=true

# Impide aplicar una migración con versión menor que la última ya aplicada.
# Si alguien crea V202608080900 después de que corrió V202608081000, Flyway avisa
# en lugar de aplicarla en desorden y dejar entornos divergentes.
flyway.outOfOrder=false
