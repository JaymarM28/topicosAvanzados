# ---------------------------------------------------------------------------
# Variables de entorno — Momento 2 (ingesta hacia Snowflake)
# Equipo 5 · RutaSegura (Cobertura Vehicular)
#
# Uso:
#   cp .env.example .env
#   Completa cada valor. `.env` está en .gitignore y NUNCA se versiona.
#
# Nota importante sobre Snowflake: cada integrante del equipo tiene su PROPIA
# cuenta de trial, y son cuentas independientes que no se ven entre sí. Lo que
# se comparte es el código (los scripts .sql de este repo), no las credenciales:
# cada quien corre el mismo setup en su cuenta y llena este archivo con SUS
# datos. Nadie necesita el .env de nadie.
# ---------------------------------------------------------------------------

# --- Neon (esta SÍ es compartida: es la base del proyecto del equipo) --------
# Connection string de la branch `dev` del proyecto RutaSegura en Neon.
NEON_DEV_DATABASE_URL=postgresql://usuario:password@ep-xxxx-dev.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Snowflake (esta es TUYA) ------------------------------------------------
# SNOWFLAKE_ACCOUNT  Snowsight -> ícono de perfil (abajo a la izquierda) ->
#                    "Account" -> copia el "Account identifier".
#                    Formato típico: <organización>-<cuenta>, ej. ABCDEFG-XY12345
# SNOWFLAKE_USER     El usuario con el que inicias sesión en Snowsight.
#                    Ojo con los espacios al final al copiar y pegar.
SNOWFLAKE_ACCOUNT=tu_identificador_de_cuenta
SNOWFLAKE_USER=tu_usuario

# Cómo te autenticas:
#   snowflake         usuario + contraseña (requiere SNOWFLAKE_PASSWORD)
#   externalbrowser   abre Snowsight en el navegador para completar el MFA;
#                     en ese caso SNOWFLAKE_PASSWORD se ignora
SNOWFLAKE_AUTHENTICATOR=snowflake
SNOWFLAKE_PASSWORD=tu_password

# --- Objetos creados por los scripts de este repo ----------------------------
# No los cambies salvo que también hayas editado los .sql correspondientes.
#   WH_VEHICLE_COVERGE  -> setup_snowflake.sql (sic: así está escrito allí)
#   VEHICLE_COVERAGE    -> setup_snowflake.sql
#   TEAM5_LOADER        -> setup_snowflake.sql
#   RAW                 -> schema destino de la carga (carga/02_raw_tables.sql)
SNOWFLAKE_WAREHOUSE=WH_VEHICLE_COVERGE
SNOWFLAKE_DATABASE=VEHICLE_COVERAGE
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=TEAM5_LOADER

# --- Autenticacion por par de llaves (recomendada) ---------------------------
# Snowflake exige MFA para los inicios de sesion con contrasena, y un segundo
# factor interactivo no sirve en un proceso automatizado. Con par de llaves el
# script se autentica sin MFA y sin navegador.
#
# Como generar la tuya (Git Bash):
#   mkdir -p ~/.snowflake && cd ~/.snowflake
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8 -nocrypt
#   openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub
# y registrar la publica en Snowsight, como ACCOUNTADMIN:
#   ALTER USER <TU_USUARIO> SET RSA_PUBLIC_KEY=<contenido de rsa_key.pub sin las
#   lineas -----BEGIN/END----- y sin saltos de linea>;
#
# La llave privada vive FUERA del repositorio: aqui solo va su ruta.
# Si esta definida, tiene prioridad sobre SNOWFLAKE_AUTHENTICATOR y PASSWORD.
SNOWFLAKE_PRIVATE_KEY_PATH=C:/Users/tu_usuario/.snowflake/rsa_key.p8
