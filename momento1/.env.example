# ---------------------------------------------------------------------------
# Plantilla de variables de entorno — Momento 1 (equipo 5)
#
# Uso:
#   1. cp .env.example .env
#   2. Pega los connection strings de TUS branches de Neon.
#
# .env está excluido en el .gitignore raíz — nunca se versiona.
# ---------------------------------------------------------------------------

# Branch dev. Es contra la que corre `inyeccion_semilla_equipo_5.py`.
# OJO: el script hace DROP TABLE. Nunca pongas aquí la URL de main.
NEON_DEV_DATABASE_URL=postgresql://usuario:clave@HOST-dev/neondb?sslmode=require

# Branch main. El script solo la usa como guardrail: si coincide con la de dev,
# aborta antes de borrar nada. Puedes dejarla vacía, pero llenarla es más seguro.
NEON_MAIN_DATABASE_URL=postgresql://usuario:clave@HOST-main/neondb?sslmode=require
